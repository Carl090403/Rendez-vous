# Copiez ce fichier en .env (jamais commité) : cp .env.example .env
# Les valeurs ci-dessous conviennent au développement local, PAS à la production.

# --- Base de données ---------------------------------------------------------
# Hors Docker. Dans docker compose, cette valeur est remplacée par l'hôte « db ».
DATABASE_URL=postgresql+psycopg://rdv:rdv@localhost:5432/rdv

# --- Sécurité ----------------------------------------------------------------
# 32 octets aléatoires minimum. Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
JWT_EXPIRE_MINUTES=60
# Origines autorisées (CORS + vérification Origin), séparées par des virgules.
# La première sert aussi aux liens dans les courriels.
FRONTEND_ORIGIN=http://localhost:3000
# Production en HTTPS : COOKIE_SECURE=true. Frontend et API sur des domaines
# différents : COOKIE_SAMESITE=none (ou mieux, le proxy API_PROXY_TARGET du frontend).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Comptes créés par scripts/seed.py --------------------------------------
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD=Admin-Demo-2026
# Compte client de démonstration (laisser vide pour ne pas le créer).
DEMO_CLIENT_EMAIL=alex@exemple.com
DEMO_CLIENT_PASSWORD=Client-Demo-2026

# --- Règles métier -----------------------------------------------------------
TIMEZONE=America/Toronto
SLOT_STEP_MIN=15
MIN_NOTICE_HOURS=2
CANCEL_LIMIT_HOURS=24
BOOKING_HORIZON_DAYS=60

# --- Commerce (courriels) ----------------------------------------------------
BUSINESS_NAME=Rendez-vous
BUSINESS_ADDRESS=

# --- Courriels ---------------------------------------------------------------
MAIL_FROM=Rendez-vous <no-reply@exemple.com>
# Développement : Mailpit. Production : renseigner RESEND_API_KEY (SMTP ignoré).
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# --- Frontend (Next.js) -------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_BUSINESS_NAME=Rendez-vous
NEXT_PUBLIC_CANCEL_LIMIT_HOURS=24
# Facultatif : relayer /api/v1 vers l'API (cookie first-party). Mettre alors
# NEXT_PUBLIC_API_URL=/api/v1.
API_PROXY_TARGET=
